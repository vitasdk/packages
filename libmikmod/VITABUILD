pkgname=libmikmod
pkgver=3.3.16
pkgrel=1
url="https://mikmod.sourceforge.net/"
source=("git+https://github.com/sezero/mikmod.git#commit=a5f5058c18a84fabf46805b5b92578933a4dbc04")
sha256sums=('SKIP')

build() {
  cd mikmod/libmikmod/
  mkdir build
  cd build
  cmake -DCMAKE_TOOLCHAIN_FILE=${VITASDK}/share/vita.toolchain.cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$prefix -DENABLE_SHARED=OFF -DENABLE_DOC=OFF ..
  make -j$(nproc)
}

package () {
  cd mikmod/libmikmod/build
  make DESTDIR=$pkgdir install
}
