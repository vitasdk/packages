pkgname=cpr
pkgver=1.15.1
pkgrel=1
url="https://docs.libcpr.dev/"
source=("https://github.com/libcpr/cpr/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('c2fc62a030c4ca5d7c3517e8068531297f938bf4ab52bf951d4fc9bbc9222716')
depends=('curl')

build() {
  cd $pkgname-$pkgver
  mkdir build && cd build
  cmake .. -DCMAKE_TOOLCHAIN_FILE=${VITASDK}/share/vita.toolchain.cmake -DCMAKE_INSTALL_PREFIX=$prefix -DCPR_USE_SYSTEM_CURL=ON -DBUILD_SHARED_LIBS=OFF
  make -j$(nproc)
}

package () {
  cd $pkgname-$pkgver/build
  make DESTDIR=$pkgdir install
}
