build() {
  cd libk
  mkdir build && cd build
  cmake ..  -DCMAKE_TOOLCHAIN_FILE=$VITASDK/share/vita.toolchain.cmake -DCMAKE_INSTALL_PREFIX=$prefix -DCMAKE_POLICY_VERSION_MINIMUM=3.5
  make -j$(nproc)
}

package () {
  cd libk/build
  make DESTDIR=$pkgdir install
}
