pkgname=unrar
pkgver=7.3.1
pkgrel=1
url="https://www.rarlab.com/"
source=("https://www.rarlab.com/rar/unrarsrc-${pkgver}.tar.gz" "unrar.patch")
sha256sums=('634900842a3737d9cc15bbcc71d4c74cc713437e0bca296a573424fe5f2660ab' 'cd5bfb86d67940e2bc144024911d9bab07cb5f3919d5c40cace44d32bc295c59')

prepare() {
  cd ${pkgname}
  patch -Np1 -i "${srcdir}/unrar.patch"
}

build() {
  cd ${pkgname}
  make -j$(nproc) -f Makefile.vita
}

package() {
  cd ${pkgname}
  mkdir -p ${pkgdir}/$VITASDK/arm-vita-eabi/lib
  mkdir -p ${pkgdir}/$VITASDK/arm-vita-eabi/include
  cp libunrar.a ${pkgdir}/$VITASDK/arm-vita-eabi/lib
  cp dll.hpp ${pkgdir}/$VITASDK/arm-vita-eabi/include/unrar.h
}
