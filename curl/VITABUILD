pkgname=curl
pkgver=8.17.0
pkgrel=3
url="https://curl.se/"
source=("https://github.com/curl/curl/releases/download/curl-8_17_0/curl-8.17.0.tar.gz"
        'link-test.c')
sha256sums=('e8e74cdeefe5fb78b3ae6e90cd542babf788fa9480029cfcee6fd9ced42b7910'
            'b629b2ad8ea9e3dbb854e88b379e2f9c08e709b58bdf865d38bb3b9104b9b428')
depends=('openssl-1.1.1' 'zlib' 'zstd')

build() {
  cd curl-${pkgver}
  mkdir build && cd build
  # CMake's Generic target omits OpenSSL's private pthread dependency from probes.
  cmake .. -DCMAKE_TOOLCHAIN_FILE=$VITASDK/share/vita.toolchain.cmake -DCMAKE_INSTALL_PREFIX=$prefix -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_CURL_EXE=OFF -DBUILD_SHARED_LIBS=OFF -DBUILD_TESTING=OFF -DENABLE_IPV6=OFF -DCURL_DISABLE_SOCKETPAIR=ON \
    -DHAVE_FCNTL_O_NONBLOCK=OFF -DENABLE_THREADED_RESOLVER=OFF -DBUILD_LIBCURL_DOCS=OFF -DBUILD_MISC_DOCS=OFF \
    -DENABLE_CURL_MANUAL=OFF -DCURL_CA_BUNDLE="vs0:data/external/cert/CA_LIST.cer" -DCURL_USE_LIBPSL=OFF \
    -DCURL_USE_OPENSSL=ON -DCMAKE_REQUIRED_FLAGS=-pthread
  sed -i '/HAVE_PIPE2/d' lib/curl_config.h
  make -j$(nproc)
}

check() {
  cd curl-${pkgver}/build
  local cflags libs features feature
  cflags=$(arm-vita-eabi-pkg-config --dont-define-prefix --cflags "$PWD/libcurl.pc")
  libs=$(arm-vita-eabi-pkg-config --dont-define-prefix --static --libs "$PWD/libcurl.pc")
  features=$(arm-vita-eabi-pkg-config --dont-define-prefix --variable=supported_features "$PWD/libcurl.pc")
  for feature in SSL NTLM TLS-SRP; do
    [[ " $features " == *" $feature "* ]] || {
      printf 'Missing curl feature: %s\n' "$feature" >&2
      return 1
    }
  done

  # Static archive creation does not resolve references to the TLS backend.
  arm-vita-eabi-gcc -Werror -Wl,-q -I../include -Llib $cflags "$srcdir/link-test.c" \
    -Wl,--start-group $libs -Wl,--end-group -o link-test.elf
  vita-elf-create link-test.elf link-test.velf
  vita-make-fself -s link-test.velf link-test.self
}

package () {
  cd curl-${pkgver}/build
  make DESTDIR=$pkgdir install
}
