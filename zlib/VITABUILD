pkgname=zlib
pkgver=1.4
pkgrel=1
pkgdesc="A lossless data-compression library for Vita"
arch=('vita')
url="https://www.zlib.net/"
license=('Zlib')
source=("https://github.com/madler/zlib/releases/download/v$pkgver/$pkgname-$pkgver.tar.xz" "zlib-no-pic.diff")
sha256sums=('4f11c512053d7bab8d9e9b89bde3575add3e4c50a383b42ef6cb837035fc5a7c' '5880305adc815c4dd3de7d7c4883f3aca824fa9273cf6fa562e77e3dd5a00cef')

prepare() {
  cd zlib-$pkgver
  patch -p1 < ../zlib-no-pic.diff
}

build() {
  cd zlib-$pkgver
  ./configure --prefix=$prefix \
    CFLAGS="-std=gnu11 -Wno-error=implicit-function-declaration -Wno-error=int-conversion"
  make -j$(nproc)
}

package () {
  cd zlib-$pkgver
  make DESTDIR=$pkgdir install
}
