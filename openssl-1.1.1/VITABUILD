build() {
  cd vita-openssl3
  ./Configure --prefix=$VITASDK/arm-vita-eabi/ no-asm no-pic no-unit-test no-shared no-ui-console vita-cross
  make -j$(nproc)
}

package () {
  cd vita-openssl3
  printf '#!/bin/bash\nmkdir -p $@\n' > util/mkdir-p.pl
  make DESTDIR=$pkgdir install
  rm -rf $pkgdir/$prefix/share # remove useless man pages
}
