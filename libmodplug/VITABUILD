pkgname=libmodplug
pkgver=0.8.9.2
pkgrel=1
url="https://github.com/Konstanty/libmodplug"
source=("git+https://github.com/Konstanty/libmodplug.git#tag=v${pkgver}")
_follow=HEAD
sha256sums=('SKIP')

build() {
  cd ${pkgname}
  mkdir build && cd build
  cmake .. -DCMAKE_TOOLCHAIN_FILE=$VITASDK/share/vita.toolchain.cmake -DCMAKE_INSTALL_PREFIX=$prefix -DHAVE_SINF:INTERNAL=1
  make -j$(nproc)
}

package() {
  cd ${pkgname}/build
  make DESTDIR=${pkgdir} install
}
