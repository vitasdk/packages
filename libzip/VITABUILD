pkgname=libzip
pkgver=1.12.1
pkgrel=1
url="https://libzip.org/"
source=("https://libzip.org/download/$pkgname-$pkgver.tar.xz")
sha256sums=('c40062022a1963c80573d48f6070792297cecd7c6bffe3aefcac0d8b9bee8913')
depends=('bzip2' 'openssl-1.1.1' 'xz' 'zlib' 'zstd')

prepare() {
  cd $pkgname-$pkgver
  printf '\nRequires.private: openssl liblzma libzstd zlib\n' >> libzip.pc.in
}

build() {
  cd $pkgname-$pkgver
  mkdir build && cd build
  cmake .. -DCMAKE_TOOLCHAIN_FILE=$VITASDK/share/vita.toolchain.cmake -DCMAKE_INSTALL_PREFIX=$prefix -DBUILD_TOOLS=OFF -DBUILD_REGRESS=OFF -DBUILD_OSSFUZZ=OFF -DBUILD_EXAMPLES=OFF -DBUILD_DOC=OFF -DBUILD_SHARED_LIBS=OFF -DHAVE_ARC4RANDOM=OFF -DOPENSSL_USE_STATIC_LIBS=ON
  make -j$(nproc)
}

package () {
  cd $pkgname-$pkgver/build
  make DESTDIR=$pkgdir install
}
